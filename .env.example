LINE_CHANNEL_SECRET=ใส่_Channel_Secret
LINE_CHANNEL_ACCESS_TOKEN=ใส่_Channel_Access_Token
TZ=Asia/Bangkok
DATABASE_PATH=moneymate.db


SUPER_ADMIN_USER_ID=

# Supabase PostgreSQL connection string
DATABASE_URL=postgresql://...

# แจ้งเตือนสมาชิกในบ้าน (1=เปิด, 0=ปิด)
NOTIFY_MEMBERS=1

# ความปลอดภัย Dashboard (สุ่มสตริงยาวๆ เช่น openssl rand -hex 32)
DASH_SECRET=
# DASH_AUTH=0   # ปิดการตรวจ token (ไม่แนะนำ)
# ลิงก์ Dashboard ที่บอทส่งให้
DASHBOARD_URL=https://your-app.onrender.com
# แจ้งเตือนอัตโนมัติ
REMINDER_HOUR=8
# REMINDERS=0

# อ่านสลิปด้วย AI (ไม่บังคับ — ไม่ตั้งคีย์ = โหมดฟรี ให้พิมพ์ยอดเอง)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
# SLIP_MODEL=claude-haiku-5-5
# SLIP_PROVIDER=auto   # auto | gemini | anthropic
# SLIP_DAILY_LIMIT=30
